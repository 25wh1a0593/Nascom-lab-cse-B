:1786954123973,"user_tz":-330,"elapsed":35,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"cb6ecfe0-bbd9-470a-d183-311e3014f198"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["df/dx = 2*x + 3*y\n","df/dy = 3*x + 2*y\n"]}]},{"cell_type":"code","source":["grad = [sp.diff(f2, v) for v in (x, y)]\n","print('grad f =', grad)\n","\n","# Evaluate the gradient at the point (x=1, y=2)\n","grad_at = [g.subs({x: 1, y: 2}) for g in grad]\n","print('grad f at (1, 2) =', grad_at)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qfvMu36OxB_M","executionInfo":{"status":"ok","timestamp":1786954247194,"user_tz":-330,"elapsed":63,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"a738d9f6-7a3e-4a8f-844b-af3043a812cb"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["grad f = [2*x + 3*y, 3*x + 2*y]\n","grad f at (1, 2) = [8, 7]\n"]}]},{"cell_type":"code","source":["by_hand = sp.cos(x**2) * 2*x\n","by_sympy = sp.diff(sp.sin(x**2), x)\n","\n","print('By hand :', by_hand)\n","print('By SymPy:', by_sympy)\n","print('Match?  ', sp.simplify(by_hand - by_sympy) == 0)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"M4d8109qxgXs","executionInfo":{"status":"ok","timestamp":1786954392260,"user_tz":-330,"elapsed":63,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"ab919c4b-6acb-461d-938a-21af78e8326d"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["By hand : 2*x*cos(x**2)\n","By SymPy: 2*x*cos(x**2)\n","Match?   True\n"]}]},{"cell_type":"code","source":["expr3 = (3*x + 1)**4\n","print('d/dx (3x+1)^4 =', sp.diff(expr3, x))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ryEQOlMMyDfr","executionInfo":{"status":"ok","timestamp":1786954518174,"user_tz":-330,"elapsed":52,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"e753c988-1650-4aa2-96c3-9f5cb6787168"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["d/dx (3x+1)^4 = 12*(3*x + 1)**3\n"]}]},{"cell_type":"code","source":["import numpy as np\n","np.random.seed(42)\n","X=np.random.randn(4,5)\n","Y = np.random.randn(4, 1)\n","W1=np.random.randn(3,5)*0.1\n","W1 = np.random.randn(5, 5) * 0.1 # Changed from (3,5) to (5,5)\n","W2 = np.random.randn(5, 1) * 0.1\n","\n","\n","z1 = X @ W1                 # linear layer 1\n","h  = np.maximum(0, z1)      # ReLU activation\n","y_hat = h @ W2              # linear layer 2 (prediction)\n","loss = ((y_hat - Y) ** 2).mean()\n","print('Initial loss:', round(loss, 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ZBks7QUg0fIX","executionInfo":{"status":"ok","timestamp":1786955094119,"user_tz":-330,"elapsed":34,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"c8a80fb5-0a81-4c64-af95-428c59db7bd1"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["Initial loss: 1.0414\n"]}]},{"cell_type":"code","source":["f5 = x**2 + 3*x*y + y**2\n","H = sp.hessian(f5, (x, y))\n","print('Hessian of f:')\n","sp.pprint(H)        # [[2, 3], [3, 2]]"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PvPTBefX1SJ1","executionInfo":{"status":"ok","timestamp":1786955292541,"user_tz":-330,"elapsed":9,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"2b9514e6-9190-4566-aa56-e06294b01bc5"},"execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["Hessian of f:\n","⎡2  3⎤\n","⎢    ⎥\n","⎣3  2⎦\n"]}]},{"cell_type":"code","source":["xv = 0.0\n","lr = 0.2\n","for step in range(15):\n","    grad = 2 * (xv - 4)\n","    xv = xv - lr * grad\n","print('Converged x:', round(xv, 3), ' (true minimum = 4)')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Qronox2U1meC","executionInfo":{"status":"ok","timestamp":1786955360396,"user_tz":-330,"elapsed":62,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"8f9e36b2-df23-4df6-e85a-33479038735f"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Converged x: 3.998  (true minimum = 4)\n"]}]},{"cell_type":"code","source":["dy   = 2 * (y_hat - Y) / Y.size      # d loss / d y_hat\n","dW2  = h.T @ dy                      # d loss / d W2\n","dh   = dy @ W2.T                     # d loss / d h\n","dz1  = dh * (z1 > 0)                 # ReLU gradient (1 where z1>0 else 0)\n","dW1  = X.T @ dz1                     # d loss / d W1\n","\n","print('dW1 shape:', dW1.shape, '(matches W1)')\n","print('dW2 shape:', dW2.shape, '(matches W2)')"],"metadata":{"id":"M54A6e1O2DzZ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import numpy as np\n","\n","# 1. Setup random seed for reproducibility\n","np.random.seed(42)\n","\n","# 2. Define dimensions (Batch Size, Input Features, Hidden Neurons, Output Units)\n","batch_size = 4\n","input_dim = 3\n","hidden_dim = 5\n","output_dim = 2\n","\n","# 3. Generate dummy data (Inputs X, True Labels Y)\n","X = np.random.randn(batch_size, input_dim)\n","Y = np.random.randn(batch_size, output_dim)\n","\n","# 4. Initialize weights\n","W1 = np.random.randn(input_dim, hidden_dim)\n","W2 = np.random.randn(hidden_dim, output_dim)\n","\n","# --- FORWARD PASS ---\n","# Layer 1: Linear transformation -> ReLU activation\n","z1 = X @ W1\n","h = np.maximum(0, z1)  # ReLU activation function\n","\n","# Layer 2: Linear transformation to yield predictions\n","y_hat = h @ W2\n","\n","# Compute Mean Squared Error (MSE) loss for tracking\n","loss = np.mean((y_hat - Y) ** 2)\n","print(f\"Current Loss: {loss:.4f}\\n\")\n","\n","dy = 2 * (y_hat - Y) / Y.size\n","\n","\n","dW2 = h.T @ dy\n","dh = dy @ W2.T\n","\n","\n","dz1 = dh * (z1 > 0)\n","\n","# Gradient for W1\n","dW1 = X.T @ dz1 # d loss / d W1\n","\n","# --- VERIFY SHAPES ---\n","print('dW1 shape:', dW1.shape, f'(matches W1 shape: {W1.shape})')\n","print('dW2 shape:', dW2.shape, f'(matches W2 shape: {W2.shape})')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"H8euWs9h2Yvu","executionInfo":{"status":"ok","timestamp":1786955543880,"user_tz":-330,"elapsed":65,"user":{"displayName":"MADUGULA MAHIJA","userId":"02795642402272812836"}},"outputId":"387d32d5-2218-4604-b003-0e42c7c8db32"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["Current Loss: 2.5395\n","\n","dW1 shape: (3, 5) (matches W1 shape: (3, 5))\n","dW2 shape: (5, 2) (matches W2 shape: (5, 2))\n"]}]}]}